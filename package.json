{
  "name": "storm-path-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.18",
    "expo-location": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:golden": "tsc -p tsconfig.golden.json --pretty false && node .golden-out/scripts/run-golden.js",
    "hardware-validate": "bash scripts/hardware-validate.sh",
    "eas:dev": "eas build --profile development",
    "eas:preview": "eas build --profile preview",
    "eas:prod": "eas build --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "submit:android": "eas submit --platform android --profile production --latest"
  },
  "private": true,
  "description": "Isolated native mobile port of Storm-Path. Zero mutation of storm-path web."
}
